# LLM 配置（OpenAI 兼容协议）
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 备用模型（主模型超时时切换）
LLM_FALLBACK_MODEL=deepseek-chat

# 模型参数
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=2000

# 服务配置
HOST=0.0.0.0
PORT=8000
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 跨域允许来源（逗号分隔，默认 *；凭证走 Authorization 头，不下发 cookie）
CORS_ALLOW_ORIGINS=*

# 指标端点：两者都配置后 GET /metrics（带 X-Metrics-Token 头或 ?token=）才可用
METRICS_ENABLED=false
METRICS_TOKEN=

# 数据存储路径
DATA_DIR=./data

# 语音识别（可选）：设备端无语音服务时，App 录音上传到这里识别
# local = 本地 whisper.cpp；openai = OpenAI 兼容 /audio/transcriptions；disabled = 关闭
ASR_PROVIDER=local
ASR_LANGUAGE=zh
# 本地 whisper.cpp（默认取项目根目录 tools/whisper）
# WHISPER_BIN=../tools/whisper/Release/whisper-cli.exe
# WHISPER_MODEL=../tools/whisper/ggml-base.bin
# OpenAI 兼容 ASR（ASR_PROVIDER=openai / siliconflow 时必填）
# ASR_API_BASE=https://api.siliconflow.cn/v1
# ASR_API_KEY=
# ASR_MODEL=XingChenAGI/XingChenASR-V3.2-Ultra

# 语音合成（硅基流动 MOSS-TTSD）
TTS_PROVIDER=siliconflow
# TTS_API_BASE=https://api.siliconflow.cn/v1
# TTS_API_KEY=
TTS_MODEL=fnlp/MOSS-TTSD-v0.5
TTS_VOICE=fnlp/MOSS-TTSD-v0.5:claire
TTS_SPEED=1.0

# ── v2 新增 ──────────────────────────────────────────────

# 内容安全（P0-5）
# 总开关；关闭后危机干预与分级词表全部失效（不建议）
MODERATION_ENABLED=true
# 词表放行后再让模型判一次（更准但多一次调用，用 DISTILL_MODEL）
MODERATION_LLM=false
# 未成年人模式：开启后露骨性描写与过度血腥一并拦截
MINOR_MODE=false
# 可选：JSON 文件扩表 {"illegal": ["...", ...]}
MODERATION_LEXICON_PATH=

# 鉴权。默认 true（Bearer token / ?token= 必填）。
# 前端登录页尚未接入前，本地开发可设为 false 走 ?user_id= 直连模式。
AUTH_ENABLED=true
# 留空则首次启动自动生成并保存到 DATA_DIR/auth_secret.key
# AUTH_SECRET=
AUTH_TOKEN_TTL=604800

# SQLite 真相源（旧 markdown/jsonl 用 python -m app.migrate_files 一次性迁入）
DB_PATH=./data/roleplay.db

# 上下文 token 预算（总窗口 + 各段占比，近似估算：CJK 每字≈1）
CTX_WINDOW_TOKENS=32000
CTX_BUDGET_PROFILE=0.25
CTX_BUDGET_SUMMARY=0.15
CTX_BUDGET_RECALL=0.15
CTX_BUDGET_HISTORY_MIN=0.40

# 混合检索
RECALL_INJECT_TOP_K=6
RECALL_VEC_THRESHOLD=0.25

# 向量召回（可选，配置后 recall 走 BM25+向量融合；留空则退化为 BM25+时间+重要性）
# EMBED_BASE_URL=
# EMBED_API_KEY=
# EMBED_MODEL=

# 蒸馏（sleep-time）专用模型，未设置时同 LLM_MODEL
DISTILL_MODEL=deepseek-chat

# 会话空闲自动蒸馏/归档
SESSION_IDLE_TIMEOUT=1800
IDLE_SWEEP_INTERVAL=300

# 群聊调度
GROUP_MEMBER_LIMIT=6
GROUP_SPEAKERS_PER_ROUND=2
GROUP_PARALLEL_REPLY=true
